# Copy to .env and fill in:  cp .env.docker.example .env
APP_NAME="My Store"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://shop.example.com
# docker compose run --rm app php artisan key:generate --show
APP_KEY=

# Published port of the web container (put a reverse proxy / HTTPS in front of it)
APP_PORT=8080
# If a reverse proxy terminates HTTPS, trust it so links and cookies use https:// ( * = any proxy )
TRUSTED_PROXIES=*

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nexcart
DB_USERNAME=nexcart
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=orders@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Optional: public key for license checks and the update feed (see docs/LICENSING.md)
NEXCART_LICENSE_PUBLIC_KEY=
NEXCART_UPDATE_URL=
